# ==============================================================================
# ProxMonitor Backend Konfiguráció (.env.example)
# Másold le .env néven a backend gyökerében, és töltsd ki a saját értékeiddel!
# A valódi .env fájl SOHA nem kerülhet be a verziókövetésbe!
# ==============================================================================

# Alkalmazás működési módja: DEMO vagy LIVE
# DEMO módban beépített mintaadatokat szolgáltat (fejlesztéshez, bemutatáshoz)
# LIVE módban a megadott Proxmox VE szerverhez csatlakozik
PROXMONITOR_MODE=DEMO

# A mobilalkalmazás és a backend közötti API hitelesítő kulcs
# Ezt az értéket kell a kliensnek fejlécben átadnia: 'X-API-Key: <kulcs>' vagy 'Authorization: Bearer <kulcs>'
PROXMONITOR_API_KEY=titkos-mobil-api-kulcs-valtoztasd-meg

# ------------------------------------------------------------------------------
# Proxmox VE Kapcsolati Beállítások (Csak LIVE módban szükségesek!)
# ------------------------------------------------------------------------------

# A Proxmox VE szerver címe (porttal együtt, pl. https://192.168.1.100:8006)
PROXMOX_HOST=https://192.168.1.100:8006

# A célcsomópont (node) neve a Proxmox klaszterben (pl. pve, proxmox1)
PROXMOX_NODE=pve

# Proxmox API Token Azonosító: USER@REALM!TOKENID formátumban
# Például: root@pam!proxmonitor vagy apiuser@pve!readonly
PROXMOX_TOKEN_ID=apiuser@pve!proxmonitor

# Proxmox API Token Secret (UUID):
# Például: 12345678-abcd-1234-abcd-123456789abc
PROXMOX_TOKEN_SECRET=00000000-0000-0000-0000-000000000000

# SSL tanúsítvány ellenőrzése:
# true  = Valódi, érvényes SSL tanúsítvány ellenőrzése
# false = Önaláírt tanúsítvány elfogadása (helyi tesztlaborban körültekintéssel)
# Vagy megadható egy egyedi CA tanúsítványfájl elérési útja is a PROXMOX_CA_CERT változóban.
PROXMOX_VERIFY_SSL=true
PROXMOX_CA_CERT=
